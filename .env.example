# Hosted API and shared runtime (never commit real secrets)
APP_ENV=development
APP_VERSION=1.0.0
API_BASE_URL=http://localhost:8080

# Laravel / Docker
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
DB_DATABASE=syncbox
DB_USERNAME=syncbox
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Object storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Container image (CI/CD)
SYNCBOX_IMAGE=ghcr.io/example/syncphoto
SYNCBOX_IMAGE_TAG=latest
NGINX_PORT=80
